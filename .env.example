# ==============================================================================
# EduVault Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual credentials.
# NEVER commit the real .env file with production credentials to source control.
# ==============================================================================

# --- Database Configuration (Supabase / PostgreSQL) ---
# Direct connection or transaction pooler JDBC URL:
# Example: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_JDBC_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
DB_DRIVER=org.postgresql.Driver
DDL_AUTO=none

# --- AI & LLM Configuration (Groq Cloud) ---
# Sign up at https://console.groq.com and generate an API key
GROQ_API_KEY=your_groq_api_key_here

# --- Cloud Storage Configuration (Backblaze B2 / AWS S3 Compatible) ---
# Backblaze B2 Application Key credentials (with read/write access to your bucket)
B2_ACCESS_KEY_ID=your_b2_access_key_id_here
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key_here
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=eduvault

# --- Server & Local Storage Settings ---
PORT=8081
APP_STORAGE_LOCAL_DIR=./data
